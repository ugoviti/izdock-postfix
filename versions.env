# izdock/postfix image and component versions (single source of truth).
#
# Read by the Dockerfile build (via build/lib.sh load_versions), by tools/build.sh (local build)
# and by the Gitea workflows (base image, image version and tags).
# Plain KEY=value lines only: no spaces, no quotes, no commands.
# The file is also shipped in the image: /usr/src/postfix/versions.env

## image version: the upstream Postfix version of the Debian package (postconf -d mail_version)
# the tags are APP_VER, X.Y, X, APP_VER-<build>, latest (.gitea/actions/image-tags).
# tools/make-updates.sh moves it when Debian ships a new Postfix (DEBIAN_CODENAME, -updates, -security);
# .gitea/actions/build-push/verify-image.sh fails when the installed Postfix is a different version
APP_VER=3.10.13

## base image - https://hub.docker.com/_/debian
# the image is docker.io/library/debian:<CODENAME>-slim@<DIGEST>: the digest pins the content
DEBIAN_CODENAME=trixie
DEBIAN_DIGEST=sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
